# ─────────────────────────────────────────────────────────────
# LinkedIn Outbound Machine — configuration
# Copy to ".env" and fill in. Never commit your real .env.
# ─────────────────────────────────────────────────────────────

# --- Access layer: which LinkedIn client to use ---
#   playwright  -> real browser automation (your server)
#   unipile     -> hosted API that holds the session for you (paid, more stable)
#   mock        -> no real actions, logs only (safe dry-run / tests)
LINKEDIN_DRIVER=mock

# --- Database ---
DB_PATH=./data/outbound.db

# --- Account warmup gate -------------------------------------------------
# The machine REFUSES to send anything until this date has passed.
# Do your 30-day manual warmup first, then set this to a past date.
# Format: YYYY-MM-DD
WARMUP_UNTIL=2099-01-01

# --- Rate limits (conservative defaults — do not raise early) ------------
MAX_INVITES_PER_DAY=15
MAX_INVITES_PER_WEEK=90
MAX_INVITES_PER_HOUR=6
MAX_MESSAGES_PER_DAY=40
# Ramp-up: invites/day during the first N days after START_DATE
RAMP_UP_DAYS=7
RAMP_UP_START_INVITES=5

# --- Work hours (in your target audience's timezone) ---------------------
WORK_HOURS_START=9
WORK_HOURS_END=17
# Comma-separated weekdays to act on (1=Mon ... 7=Sun)
WORK_DAYS=1,2,3,4,5
TIMEZONE=Europe/Berlin

# --- Human-like delays between actions (seconds) -------------------------
MIN_DELAY_SECONDS=90
MAX_DELAY_SECONDS=420

# --- Sequence timing (days) ----------------------------------------------
DAYS_BEFORE_FIRST_DM=1
DAYS_BEFORE_FOLLOWUP_1=3
DAYS_BEFORE_FOLLOWUP_2=4
DAYS_BEFORE_DONE=5

# --- Status re-check throttling (ban-safety) -----------------------------
# Re-check a given lead (accepted? replied?) at most every N hours, and check
# at most this many leads per tick. Keeps real-browser navigations human-like.
CHECK_INTERVAL_HOURS=6
MAX_CHECKS_PER_TICK=5

# --- Invitations ---------------------------------------------------------
# Attach a personalized note? LinkedIn caps NOTED invites hard (free accounts
# ~5/month). Once the monthly budget below is spent, the machine keeps inviting
# WITHOUT a note instead of failing. Set MAX_NOTED_INVITES_PER_MONTH=0 = unlimited.
ATTACH_NOTE=true
MAX_NOTED_INVITES_PER_MONTH=5
# Withdraw invites still pending after this many days (too many open invites is
# itself a ban signal). Bounded per tick to stay human-like.
WITHDRAW_INVITE_AFTER_DAYS=21
MAX_WITHDRAWALS_PER_TICK=2

# --- Safety: circuit breaker ---------------------------------------------
# If LinkedIn shows a checkpoint / auth wall, the machine stops sending and
# stays dark for this many hours (and alerts you). Log in manually to clear it.
SAFETY_BREAKER_COOLDOWN_HOURS=12

# --- Personalization (Claude) --------------------------------------------
#   claude-cli -> uses your Claude Max plan via the `claude` CLI (headless)
#   template   -> deterministic local templates (no AI, used for tests)
PERSONALIZER=template
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-4-6

# --- Your offer / context (fed to the personalizer) ----------------------
SENDER_NAME=Your Name
SENDER_ROLE=Founder
VALUE_PROP=I help B2B teams book more meetings with AI-driven outbound.

# --- Playwright / session (only for LINKEDIN_DRIVER=playwright) -----------
LINKEDIN_SESSION_PATH=./data/li-session.json
# Residential proxy MATCHING YOUR USUAL LOGIN LOCATION. Required on a VPS.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
HEADLESS=true

# --- Unipile (only for LINKEDIN_DRIVER=unipile) --------------------------
# Hosted LinkedIn access. Connect the account once in Unipile's dashboard, then:
UNIPILE_DSN=                 # your API base, e.g. https://api123.unipile.com:13456
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=          # the connected LinkedIn account id

# --- Email fallback channel (optional, via Instantly) --------------------
# LinkedIn is the focus; email is the fallback. When a LinkedIn invite is
# withdrawn as stale and the lead has an email, the lead is enrolled into your
# Instantly campaign. Email replies pull the lead out; a LinkedIn reply pauses
# the email sequence.
#   none      -> email channel off (default)
#   instantly -> real Instantly API
#   mock      -> no real actions, logs only (dry-run / tests)
EMAIL_CHANNEL=none
EMAIL_HANDOFF_ON_WITHDRAW=true
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
# INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2

# --- Inbound engine (content -> engagement -> magnet -> capture) ----------
# The primary, LeadPanther-style motor. Posts promote a lead magnet; people who
# comment the trigger word get the magnet by DM; emails are captured and handed
# to your CRM. Drive it with `npm run inbound-tick` / `inbound-loop`.
#
# ICP/topics/trigger/delivery are best set PER CAMPAIGN (dynamic, many in parallel):
#   npm run campaign -- add --name "DACH SaaS" --icp "..." --topics "a,b" --trigger guide
#   npm run gen-magnet -- "<topic>" --campaign <id>
# The INBOUND_* values below are only FALLBACK DEFAULTS when no campaign is set.
INBOUND_ICP=B2B SaaS founders            # fallback audience (drives quality)
INBOUND_TOPICS=cold outbound,deliverability   # fallback content themes
INBOUND_TRIGGER_WORD=guide               # fallback comment keyword
MAGNET_DELIVERY=dm                       # fallback: dm (link in chat) | gated (landing page)
CAPTURE_BASE_URL=http://localhost:3000   # public URL of the capture server
INBOUND_AUTO_ACCEPT=true                 # auto-accept invites from people who engaged
INBOUND_SCAN_INTERVAL_HOURS=4            # how often to re-scan a post's comments
# Per-tick budgets (kept low to stay human-like)
MAX_POSTS_PER_TICK=1
MAX_SCANS_PER_TICK=3
MAX_INBOUND_DMS_PER_TICK=1
# Content model (Claude via your Max plan; PERSONALIZER=claude-cli to use it)
CONTENT_MODEL=claude-opus-4-8
# Capture web server port
CAPTURE_PORT=3000

# --- Admin dashboard (monitor + control everything) ----------------------
# Password-protected web UI. Set a strong password; put it behind HTTPS.
ADMIN_PASSWORD=
ADMIN_PORT=3001

# --- CRM hand-off (Pipedrive) --------------------------------------------
# Captured / taken-over inbound leads are created in your CRM automatically.
#   none      -> off (default)
#   pipedrive -> real Pipedrive API (token)
#   mock      -> no real actions (dry-run / tests)
CRM_PROVIDER=none
CRM_CREATE_ON=both                       # capture | reply | both
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_OWNER_ID=
# PIPEDRIVE_BASE_URL=https://api.pipedrive.com/v1

# --- Notifications (optional) --------------------------------------------
#   console | telegram
NOTIFY_DRIVER=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
